{
  "name": "overlap-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Снапшот-бэкенд данных приложения Overlap: зеркала источников (Jolpica/OpenF1/fiawec/Al Kamel/fia.com) и derived-карточки для F1/WEC/IMSA.",
  "scripts": {
    "imsa": "tsx src/producers/imsa.ts",
    "f1": "tsx src/producers/f1.ts",
    "openf1": "tsx src/producers/openf1.ts",
    "wec": "tsx src/producers/wec.ts",
    "fia": "tsx src/producers/fia.ts",
    "health": "tsx src/producers/health.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "wecfia": "tsx src/producers/wecfia.ts",
    "wechighlights": "tsx src/producers/wechighlights.ts",
    "wecwinners": "tsx src/producers/wecwinners.ts",
    "imsafia": "tsx src/producers/imsafia.ts",
    "imsahighlights": "tsx src/producers/imsahighlights.ts",
    "imsawinners": "tsx src/producers/imsawinners.ts",
    "f1history": "tsx src/producers/f1history.ts",
    "tracks": "tsx src/producers/tracks.ts",
    "f1winners": "tsx src/producers/f1winners.ts",
    "f1highlights": "tsx src/producers/f1highlights.ts",
    "f1milestones": "tsx src/producers/f1milestones.ts",
    "f1records": "tsx src/producers/f1records.ts",
    "f1beasts": "tsx src/producers/f1beasts.ts",
    "f1overrides": "tsx src/producers/f1overrides.ts",
    "f1teams": "tsx src/producers/f1teams.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "unpdf": "^1.6.2"
  }
}
